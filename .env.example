# Server-side secrets only. Never copy these values into the Android APK.
# Configure them in the existing Hub-Mind server/Netlify environment.
GEMINI_API_KEY=
GEMINI_GROUNDED_MODEL=

# Firebase web app configuration for the Hub-Mind website/server.
# The Android app uses its own locally supplied app/google-services.json
# registered in the same Firebase project.
FIREBASE_APP_ID=
FIREBASE_AUTH_DOMAIN=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_WEB_API_KEY=
FIRESTORE_DATABASE_ID=
GITHUB_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_SECRET=
VITE_GOOGLE_CLIENT_ID=