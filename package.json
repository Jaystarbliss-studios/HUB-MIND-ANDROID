{
  "name": "hub-mind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "node scripts/build.mjs",
    "gcp-build": "node scripts/build.mjs",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist build out server.js",
    "lint": "tsc --noEmit",
    "backup:jess": "node scripts/backup-jess-ai.mjs",
    "restore:jess": "node scripts/restore-jess-ai.mjs",
    "verify:jess": "node scripts/verify-jess.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/jess/*.test.mjs tests/security/*.test.ts tests/security/*.test.mjs tests/auth/*.test.ts tests/auth/*.test.mjs tests/recurrence/*.test.ts",
    "test": "npm run verify:jess && npm run typecheck && npm run test:unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-hubmind \"node --import tsx --test tests/security/firestore.rules.emulator.test.ts\"",
    "desktop:dev": "npm run build && electron .",
    "desktop:package:win": "npm run build && npm run build:native:win && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-windows-icon.ps1 && electron-builder --win nsis --publish never",
    "build:native:win": "dotnet publish native/JessChromeNativeHost/JessChromeNativeHost.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o native/JessChromeNativeHost/publish && dotnet publish native/JessOfflineWake/JessOfflineWake.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o native/JessOfflineWake/publish && dotnet publish native/JessWindowsOcr/JessWindowsOcr.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o native/JessWindowsOcr/publish"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-font-family": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-subscript": "^3.29.2",
    "@tiptap/extension-superscript": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-table-cell": "^3.29.2",
    "@tiptap/extension-table-header": "^3.29.2",
    "@tiptap/extension-table-row": "^3.29.2",
    "@tiptap/extension-task-item": "^3.29.2",
    "@tiptap/extension-task-list": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase": "^12.17.0",
    "groq-sdk": "^1.5.0",
    "html-to-docx": "^1.8.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.12.0",
    "motion": "^12.23.24",
    "openai": "^7.4.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-background-sync": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/dompurify": "^3.2.0",
    "@types/express": "^4.17.21",
    "@types/html2canvas": "^1.0.0",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "firebase-tools": "^15.32.1",
    "sharp": "^0.35.5"
  },
  "main": "electron/main.cjs"
}
